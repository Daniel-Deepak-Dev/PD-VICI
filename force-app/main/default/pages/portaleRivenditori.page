<apex:page applyBodyTag="false" applyHtmlTag="false" showHeader="false" standardStylesheets="false" controller="cPortaleRivenditori" language="{!$CurrentPage.parameters.lang}" cache="false">
    <html xmlns:v-on="http://gnet.it/vue" xmlns:v-bind="http://gnet.it/vue" >
        <head>
            <title>Partner Portal</title>
            <meta charset="UTF-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1.0" />
            <apex:includeScript value="{!URLFOR($Resource.basic_libraries , '/js_head/vue.js')}"/>
            <apex:includeScript value="{!$Resource.asyncJS}"/>
            <link rel="stylesheet" href="{!URLFOR($resource.bootstrap3,'bootstrap-3.3.7-dist/css/bootstrap.min.css')}" />
            <link rel="stylesheet" href="{!URLFOR($resource.bootstrap3,'bootstrap-3.3.7-dist/css/bootstrap-theme.min.css')}" />
            <apex:stylesheet value="{!$Resource.portaleRivenditori_CSS}" />
            <script>
            (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
                (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
                    m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
                                    })(window,document,'script','https://www.google-analytics.com/analytics.js','ga');
            ga('create', '{!$Setup.Configuration__c.Partner_Portal_GA__c}', 'auto');
            ga('send', 'pageview');
            
            </script>   
        </head>
        <body class="portal-body-background">
            <nav class="navbar portal-navbar ">
                <div class="container-fluid">
                    <img class="navbar-brand" src="{!$resource.LogoVici}" />
                    <img class="navbar-brand" src="{!$resource.logoMetrios}" />
                    <ul class="nav navbar-nav navbar-right">
                        <li>
                            <a href="" >
                                <p class="title" id="busy" style="display:none">Loading...</p>
                            </a>
                        </li>
                        <li>
                            <p class="navbar-text nav-title portal-nav-title">Partner Portal</p>
                            
                        </li>
                    </ul>
                    
                </div>
            </nav>
            <div id="myApp" >
                <div v-if="ready">
                    <!-- LOGIN PANEL -->
                    <div class="container-fluid col-sm-12 col-md-12" style="margin-top:10px" v-if="ready && showLogin">
                        <div class="row">
                            <div class="col-sm-12 col-md-12">
                                <div class="panel">
                                    <div class="panel-heading text-center" >
                                        <span class="title"> LOGIN</span>
                                    </div>
                                </div>
                                <div class="panel-body portal-panel-background">
                                    <div class="row">
                                        <div class="col-xs-12 col-sm-12 col-md-4  col-md-offset-4 ">
                                            <div class="form-group">
                                                <div class="input-group">
                                                    <span class="input-group-addon">
                                                        <i class="glyphicon glyphicon-user"></i>
                                                    </span>
                                                    <input class="form-control" placeholder="Username" name="registerFirstName" type="text" 
                                                           v-model="credentials.username"
                                                           />
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <div class="input-group">
                                                    <span class="input-group-addon">
                                                        <i class="glyphicon glyphicon-lock"></i>
                                                    </span>
                                                    <input class="form-control" placeholder="Password" name="Enter your username" type="text" 
                                                           v-model="credentials.password"
                                                           />
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <a>
                                                    <button type="button" class="form-button portal-form-button" v-on:click="logIn" >LOGIN</button>
                                                </a>
                                            </div>
                                            <div class="alert alert-danger" v-if="error">
                                                <p>{{credentials.error}}</p>
                                            </div>    
                                            <a v-on:click="forgetYourPwd" >Forget your password?</a>
                                        </div>
                                    </div> 
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- END LOGIN PANEL -->
                    
                    
                    <!-- FORGET YOUR PASSWORD PANEL -->
                    <div class="container-fluid col-sm-12 col-md-12" style="margin-top:10px" v-if="ready && showForgetYourPwd">
                        <div class="row">
                            <div class="col-sm-12 col-md-12">
                                <div class="panel">
                                    <div class="panel-heading text-center" >
                                        <span class="title"> FORGET YOUR PASSWORD</span>
                                    </div>
                                </div>
                                <div class="panel-body portal-panel-background">
                                    <div class="row">
                                        <div class="col-xs-12 col-sm-12 col-md-4  col-md-offset-4 ">
                                            <div class="form-group">
                                                <div class="input-group">
                                                    <span class="input-group-addon">
                                                        <i class="glyphicon glyphicon-envelope "></i>
                                                    </span>
                                                    <input class="form-control" placeholder="E-mail" name="email" type="text"
                                                           v-model="credentials.email"/>
                                                </div>
                                            </div>
                                            <div class="form-group">
                                                <a>
                                                    <button type="button" class="form-button portal-form-button" v-on:click="sendEmailForgetPwd" >SUBMIT</button>
                                                </a>
                                            </div>
                                            <div class="alert alert-danger" v-if="errorSendEmail">
                                                <p>{{credentials.errorSendEmail}}</p>
                                            </div> 
                                        </div>
                                    </div> 
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- END FORGET YOUR PASSWORD -->
                    
                    <!-- FORGET YOUR PASSWORD  MESSAGE PANEL -->
                    <div class="container-fluid col-sm-12 col-md-12" style="margin-top:10px" v-if="ready && showSendEmail">
                        <div class="row">
                            <div class="col-sm-12 col-md-12">
                                <div class="panel">
                                    <div class="panel-heading text-center" >
                                        <span class="title"> THANK YOU </span>
                                    </div>
                                </div>
                                <div class="panel-body portal-panel-background">
                                    <div class="row">
                                        <div class="col-xs-12 col-sm-12 col-md-4  col-md-offset-4 ">
                                            We will be sending an email with your user credential.
                                        </div>
                                    </div> 
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- END FORGET YOUR PASSWORD -->
                    
                    
                    
                    <!-- TAB PANEL -->
                    <div class="container-fluid col-sm-12 col-md-12" v-if="ready && showTab">
                        <div class="container-fluid col-sm-12 col-md-12" >
                            <div class="row">
                                <div class="col-sm-12 col-md-12">
                                    <ul class="nav nav-tabs">
                                        <li class="active"><a href="#home" data-toggle="tab">Home</a></li>  
                                        <li><a href="#tablead" data-toggle="tab">Lead</a></li>
                                        <li><a href="#tabopportunita" data-toggle="tab">Opportunity</a></li>
                                        <li><a href="#tabcase" data-toggle="tab">Cases</a></li>  
                                        <li><a href="#tabmaterialemarketing" data-toggle="tab">Download</a></li>
                                    </ul>
                                    
                                    <div class="tab-content">
                                        
                                        <!-- TAB HOME -->
                                        <div class="tab-pane fade in active" id="home" > 
                                            <div class="panel" >
                                                <div class="panel-heading text-center" >
                                                    <span class="title"> Home</span>
                                                </div>
                                            </div>
                                            <div class="panel-body portal-panel-background">
                                                
                                                <table  class="table" style="margin-top:10px">
                                                    <thead>
                                                        <th>WELCOME TO THE PARTNER PORTAL</th>
                                                    </thead>
                                                    <tbody>
                                                        <tr>
                                                            <td>
                                                                <p class="title">Aim of the tool </p>
                                                                <p class="title">Sales</p>
                                                                <ul>
                                                                    <li>Mutual sharing of opportunities.</li>
                                                                    <li>Progress of opportunities.</li>
                                                                </ul>
                                                                <p class="title">Service</p>
                                                                <ul>
                                                                    <li>Open cases and solved cases.</li>
                                                                </ul>
                                                                <p class="title">Marketing, Sales and Service</p>
                                                                <ul>
                                                                    <li>Download Area</li>
                                                                </ul>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                        <!--END TAB HOME -->
                                        
                                        <!-- TAB LEAD -->
                                        <div class="tab-pane" id="tablead" >
                                            
                                            <div class="panel" >
                                                <div class="panel-heading text-center" >
                                                    <span class="title"> Lead</span>
                                                </div>
                                            </div>
                                            <div class="panel-body portal-panel-background">
                                                <div v-if="showLead" >
                                                    <p style="color:red;">
                                                        <strong>Click on the lens icon to read about: phone, email, city, notes.</strong><br/>
                                                        Instructions to save the record: fill all the fields, change the Status and write Your Feedback. <br/>
                                                        Per salvare il lead: completa tutti i campi, cambia lo Status e scrivi i tuoi commenti nel campo Your Feedback. <br/><br/>
                                                    </p>
                                                </div>
                                                <table is="gn-table" v-if="showLead"
                                                       v-bind:fieldsmap="sobject.tableLead.fieldsMap"
                                                       v-bind:arraycolumn="sobject.tableLead.configurazioneColonne"
                                                       v-bind:arrayrow="sobject.tableLead.datiRighe"
                                                       v-bind:config="sobject.tableLead"
                                                       v-on:refreshtable="refreshTable"
                                                       v-bind:iddealer="credentials.idDealer"
                                                       v-bind:showdetail="true"
                                                       v-on:openform="setForm" 
                                                       v-on:openlink="openLink">
                                                </table> 
                                                
                                                
                                                
                                                <table is="gn-form" v-if="!showLead" 
                                                       v-bind:fieldsmap="sobject.tableLeadExploded.fieldsMap"
                                                       v-bind:arrayrow="sobject.tableLeadExploded.strutturaForm"
                                                       v-bind:datiform="sobject.tableLeadExploded.datiForm"
                                                       v-bind:config="sobject.tableLeadExploded"
                                                       v-bind:idDealer="credentials.idDealer"
                                                       v-bind:showdetail="false"
                                                       v-on:refreshtable="refreshTable"
                                                       v-on:returntable="showLead=true">
                                                </table>                                                 
                                                <div v-if="showLead" >
                                                    <button type="button" class="btn" style="float:right" v-on:click="addRowTable(sobject.tableLead)"  >
                                                        <span class="glyphicon glyphicon-plus"></span>
                                                        Add
                                                    </button>
                                                </div>
                                                
                                            </div>
                                        </div>
                                        <!--END TAB LEAD -->
                                        
                                        
                                        <!-- TAB OPPORTUNITA + TAB OPPORTUNITA ESPLOSO -->
                                        <div class="tab-pane" id="tabopportunita" >
                                            
                                            
                                            <div class="panel" >
                                                <div class="panel-heading text-center" >
                                                    <span class="title"> Opportunity </span>
                                                </div>
                                            </div>
                                            <div class="panel-body portal-panel-background">
                                                
                                                <table is="gn-table" v-if="showOpportunity"
                                                       v-bind:fieldsmap="sobject.tableOpportunity.fieldsMap"
                                                       v-bind:arraycolumn="sobject.tableOpportunity.configurazioneColonne"
                                                       v-bind:arrayrow="sobject.tableOpportunity.datiRighe"
                                                       v-bind:config="sobject.tableOpportunity"
                                                       v-bind:showdetail="true"
                                                       v-bind:iddealer="credentials.idDealer"
                                                       v-on:refreshtable="refreshTable"
                                                       v-on:openform="setForm">
                                                </table> 
                                                
                                                <button v-if="showOpportunity" type="button" class="btn" style="float:right" v-on:click="addRowTable(sobject.tableOpportunity)"  >
                                                    <span class="glyphicon glyphicon-plus"></span>
                                                    Add
                                                </button>
                                                
                                                <table is="gn-form" v-if="!showOpportunity" 
                                                       v-bind:fieldsmap="sobject.tableOpportunityExploded.fieldsMap"
                                                       v-bind:arrayrow="sobject.tableOpportunityExploded.strutturaForm"
                                                       v-bind:datiform="sobject.tableOpportunityExploded.datiForm"
                                                       v-bind:config="sobject.tableOpportunityExploded"
                                                       v-bind:idDealer="credentials.idDealer"
                                                       v-bind:showdetail="false"
                                                       v-on:refreshtable="refreshTable"
                                                       v-on:returntable="showOpportunity=true">
                                                </table> 
                                                
                                                <table is="gn-attachment"  v-if="!showOpportunity"
                                                       v-bind:parentid="sobject.tableOpportunityExploded.datiForm[0].Id"
                                                       >
                                                </table> 
                                            </div>
                                            
                                        </div>
                                        <!--END TAB OPPORTUNITA CASE -->
                                        
                                        <!-- TAB CASE  -->
                                        <div class="tab-pane" id="tabcase" >
                                            <div class="panel" >
                                                <div class="panel-heading text-center" >
                                                    <span class="title"> CASE</span>
                                                </div>
                                            </div>
                                            
                                            <div class="panel-body portal-panel-background">
                                                
                                                <table is="gn-table"
                                                       v-bind:fieldsmap="sobject.tableCase.fieldsMap"
                                                       v-bind:arraycolumn="sobject.tableCase.configurazioneColonne"
                                                       v-bind:arrayrow="sobject.tableCase.datiRighe"
                                                       v-bind:config="sobject.tableCase"
                                                       v-on:refreshtable="refreshTable"
                                                       v-bind:idDealer="credentials.idDealer"
                                                       v-bind:showdetail="false">
                                                </table> 
                                                <button type="button" class="btn" style="float:right" v-on:click="addRowTable(sobject.tableCase)"  >
                                                    <span class="glyphicon glyphicon-plus"></span>
                                                    Add
                                                </button>   
                                            </div>                                            
                                        </div>
                                        <!-- END TAB CASE  -->    
                                        
                                        <!-- TAB MATERIALE MARKETING -->
                                        <div class="tab-pane" id="tabmaterialemarketing" >
                                            <div class="panel" >
                                                <div class="panel-heading text-center" >
                                                    <span class="title"> Download</span>
                                                </div>
                                            </div>
                                            
                                            <div class="panel-body portal-panel-background">
                                                <table is="gn-table"
                                                       v-bind:fieldsmap="sobject.tableDocumentationMarketing.fieldsMap"
                                                       v-bind:arraycolumn="sobject.tableDocumentationMarketing.configurazioneColonne"
                                                       v-bind:arrayrow="sobject.tableDocumentationMarketing.datiRighe"
                                                       v-bind:config="sobject.tableDocumentationMarketing"
                                                       v-on:openlink="openLink" >
                                                </table> 
                                                
                                            </div>
                                        </div>
                                        <!-- END TAB MATERIALE MARKETING -->
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- END TAB -->
                    </div>
                </div>
            </div>
            <c:gnField >
            </c:gnField>  
            <c:gnRow >
            </c:gnRow>    
            <c:gnTable >
            </c:gnTable> 
            <c:gnForm >
            </c:gnForm>
            <c:gnAttachment >
            </c:gnAttachment> 
        </body>
        
        
        <!-- LIBRERIE JS -->
        
        <script src="{!URLFOR($Resource.basic_libraries , './js_body/vuex.js')}"></script>
        <script src="{!URLFOR($Resource.basic_libraries , './js_body/jquery-3.2.1.js')}"></script>
        <script src="{!$resource.momentjs}"></script>
        <script src="{!URLFOR($Resource.basic_libraries , './js_body/vue-simple-spinner.min.js')}"></script>
        <script src="{!URLFOR($resource.bootstrap3,'bootstrap-3.3.7-dist/js/bootstrap.min.js')}"></script>  
        <script src="{!$Resource.gnColumn}" /> 
            <script src="{!$Resource.myApp}" /> 
                
                </html>
            </apex:page>