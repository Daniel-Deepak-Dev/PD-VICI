            <style type="text/css" >
                /* Web site Styles */
                /* Fixes for cross browsers compatibility */
                html{font-size:100%;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;}/*Corrects text resizing oddly in IE 6/7 when body `font-size` is set using `em` units. Prevents iOS text size adjust after orientation change, without disabling user zoom.*/
                body{margin:0;}/* Addresses margins handled incorrectly in IE 6/7. */
                a:focus{outline:thin dotted;}/* Addresses `outline` inconsistency between Chrome and other browsers. */
                a:active,a:hover{outline:0;}/* Improves readability when focused and also mouse hovered in all browsers. */
                b,strong{font-weight:bold;}/* Addresses style set to `bolder` in Firefox 3+, Safari 4/5, and Chrome. */
                p,pre{margin:1em 0;}/* Addresses margins set differently in IE 6/7. */
                dl,ol,ul{margin:1em 0;}/* Addresses margins set differently in IE 6/7. */
                dd{margin:0 0 0 40px;}
                ol,ul{padding:0 0 0 40px;}/* Addresses paddings set differently in IE 6/7. */
                img{border:0;-ms-interpolation-mode:bicubic;}/* Removes border when inside `a` element in IE 6/7/8/9 and Firefox 3. Improves image quality when scaled in IE 7. */
                form{margin:0;}/* Corrects margin displayed oddly in IE 6/7. */
                input:focus,select:focus,textarea:focus,button:focus{outline-width:0;}/* Chrome and Safari reset */
                button,input,select,textarea{font-size:100%;}/* Corrects font size not being inherited in all browsers. */
                button,input{line-height:normal;}/* Addresses Firefox 3+ setting `line-height` on `input` using `!important` in the UA stylesheet. */
                button,html input[type="button"],input[type="reset"],input[type="submit"]{-webkit-appearance:button;cursor:pointer;overflow:visible;}/* Avoid the WebKit bug in Android 4.0.* where (2) destroys native `audio` and `video` controls. Corrects inability to style clickable `input` types in iOS. Improves usability and consistency of cursor style between image-type `input` and others. Removes inner spacing in IE 7 without affecting normal text inputs.  Known issue:inner spacing remains in IE 6. */
                button[disabled],input[disabled]{cursor:default;}/* Re-set default cursor for disabled elements. */
                input[type="checkbox"],input[type="radio"]{box-sizing:border-box;padding:0;height:13px;width:13px;margin-right:5px;cursor:pointer;}/* Addresses box sizing set to content-box in IE 8/9. Removes excess padding in IE 8/9. Removes excess padding in IE 7. Known issue:excess padding remains in IE 6. */
                button::-moz-focus-inner,input::-moz-focus-inner{border:0;padding:0;}/* Removes inner padding and border in Firefox 3+. */
                textarea{overflow:auto;vertical-align:top;}/* Removes default vertical scrollbar in IE 6/7/8/9. Improves readability and alignment in all browsers. */
                table{border-collapse:collapse;border-spacing:0;}/* Remove most spacing between table cells. */
                textarea{resize:vertical;}
                img{vertical-align:middle;}
                
                /* General - Styles applies to forms (subscriprion, unsubscribe,..), survey, landing pages and web page*/
                body {background-color:#e9e9e9;color:#363636;font-family:Arial, Helvetica, sans-serif;font-size:14px;padding:0 15px;line-height:1.5;}
                .pagecontainer{max-width:720px;width:expression(document.body.clientWidth > 720? "720px": "auto" )/*ie6 fix */;min-width:240px;margin:30px auto;background-color:#ffffff;padding:30px 30px;min-height:300px;box-shadow:0px 1px 8px 0px rgba(0, 0, 0, 0.35);border-radius:8px;}
                h1,h2,h3,h4,h5,h6{margin:0 0 13px 0;line-height:1.1;}
                h1{font-size:60px;}
                h2{font-size:16px;}
                h3{font-size:16px;}
                h4{font-size:14px;}
                h5{font-size:12px;}
                h6{font-size:10px;}
                p{margin:0;padding:0 0 13px 0;line-height:1.5;}
                a, a:hover {color:#126b92;}
                
                /* Contact Flows specific */
                p.formfield,p.captcha,p.submit{margin:8px 0 15px 0;padding:0;}
                p.formfield label,p.captcha label{font-weight:bold;display:block;line-height:1.5;clear:both;margin-bottom:3px;}
                p.formfield input[type="text"], .formfield input[type="password"],p.captcha input[type="text"]{width:300px;margin:0;border:1px solid #CCCCCC;border-radius:3px;padding:5px;}
                p.formfield select {border:1px solid #CCCCCC;border-radius:3px;padding:5px 3px;width:300px;}
                p.formfield textarea {font-family:Arial, Helvetica, sans-serif;width:100%;resize:none;}
                p.formfield textarea.privacy{color:#666666;font-size:10px;}
                p.captcha img{display:block;}
                p.submit input[type="submit"]{cursor:pointer;background-color:#777777;border:solid 1px #666666;padding:4px 11px 5px 11px;color:white;font-size:15px;font-weight: bold;border-radius:3px;display:block;}
                p.submit input[type="submit"]:hover{background-color:#999999;}
                .errors {margin:10px 0;padding:10px;background-color:#FFEEEE;color:#330000;font-weight:bold;border-radius:3px;}
                .errors ul{padding:0 0 0 30px;margin:0;}
                .errors li{font-size:12px;font-weight:normal;}
                .errormessage {color:#990000;font-weight:bold;}
                @media only screen and (max-width: 380px){
                p.formfield input[type="text"], .formfield input[type="password"],p.captcha input[type="text"],p.formfield select{width:95%;}
                p.submit{text-align:center;}
                }
                .btn-success  {
                color: #fff !important;
                text-decoration: none !important;
                }
                
                body{background-color:#ffffff;color:#363636;font-family: 'Open Sans', Arial,sans-serif;font-size:14px;padding:0 15px;line-height:1.5;}
