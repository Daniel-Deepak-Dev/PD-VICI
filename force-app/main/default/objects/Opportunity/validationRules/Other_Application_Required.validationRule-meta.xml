<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Other_Application_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Industry__c, &quot;Other&quot;),
  ISBLANK(Other_application__c)
)</errorConditionFormula>
    <errorDisplayField>Other_application__c</errorDisplayField>
    <errorMessage>Please specify the other application.</errorMessage>
</ValidationRule>
