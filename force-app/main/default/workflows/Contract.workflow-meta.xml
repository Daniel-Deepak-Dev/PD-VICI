    <rules>
        <fullName>Contract Send mail with Yearly Expiration Notice</fullName>
        <actions>
            <name>Aggiorna_Reminder_Counter</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Contract.Set_Reminder__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <description>Nei contratti Service manda una mail all&apos;ower del contratto e al cliente che ha firmato che segnala prossima scadenza annuale del contratto 60gg prima, comadato dalla checkbox  Send Mail Yearly Reminder trovato da una formula</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <actions>
                <name>Contract_Send_Mail_Yearly_Expiration_Notice_to_Contract_Ower_and_Contract_Custom</name>
                <type>Alert</type>
            </actions>
            <actions>
                <name>Aggiorna_Contatore_Mail_mandate</name>
                <type>FieldUpdate</type>
            </actions>
            <actions>
                <name>ResetReminder</name>
                <type>FieldUpdate</type>
            </actions>
            <actions>
                <name>Notifica_scadenza_annuale</name>
                <type>Task</type>
            </actions>
            <offsetFromField>Contract.Contract_Yearly_End_Date__c</offsetFromField>
            <timeLength>-30</timeLength>
            <workflowTimeTriggerUnit>Days</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
    <tasks>
        <fullName>NotificaScadenzaAnnuale_rimettere_eventualmente_spuntaReminder</fullName>
        <assignedToType>owner</assignedToType>
        <description>Quando manda la mail di notifica scadenza annuale a 30gg imposta un task il giorno dopo la scadenza dove ricorda di  rimettere la spunta sul Reminder per la prossima scadenza annuale.</description>
        <dueDateOffset>1</dueDateOffset>
        <notifyAssignee>false</notifyAssignee>
        <offsetFromField>Contract.Contract_Yearly_End_Date__c</offsetFromField>
        <priority>Bassa</priority>
        <protected>false</protected>
        <status>Non iniziata</status>
        <subject>Notifica scadenza annuale, rimettere eventualmente la spunta di Reminder prossima scadenza</subject>
    </tasks>
    <tasks>
        <fullName>Notifica_scadenza_annuale</fullName>
        <assignedToType>owner</assignedToType>
        <description>Quando manda la mail di notifica scadenza annuale a 30gg imposta un task il giorno dopo la scadenza dove ricorda di rimettere la spunta sul Reminder per la prossima scadenza annuale.</description>
        <dueDateOffset>1</dueDateOffset>
