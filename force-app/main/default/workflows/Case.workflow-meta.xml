        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Case.Status_notifica__c</field>
            <operation>equals</operation>
            <value>Invia notifica</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
