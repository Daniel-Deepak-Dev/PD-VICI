    <rules>
        <fullName>Case Machine Warranty %28da Warranty Status checkbox formula%29 FALSE</fullName>
        <actions>
            <name>Aggiorna_campo_InWarranty_a_NO</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Case.Asset_Final_Customer_Formula__c</field>
            <operation>equals</operation>
            <value>MTL</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Warranty_Status_checkbox__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.In_Warranty__c</field>
            <operation>notEqual</operation>
            <value>Yes</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.In_Warranty__c</field>
            <operation>notEqual</operation>
            <value>No</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Warranty_formula__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <description>Nei casi service aggiorna il campo In Warranty a NO quando si inserisce Asset se:
- Asset Final Customer Formula è MTL (inserito altrimenti non funziona)
- Warranty Status checkbox è false
- In Warranty è vuoto
- Expiration Warranty è non vuoto</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Case Machine Warranty %28da Warranty Status checkbox formula%29 TRUE</fullName>
        <actions>
            <name>Aggiorna_campo_InWarranty_a_SI</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Case.Asset_Final_Customer_Formula__c</field>
            <operation>equals</operation>
            <value>MTL</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Warranty_Status_checkbox__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.In_Warranty__c</field>
            <operation>notEqual</operation>
            <value>Yes</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.In_Warranty__c</field>
            <operation>notEqual</operation>
            <value>No</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Warranty_formula__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <description>Nei casi service aggiorna il campo In Warranty a SI quando si inserisce Asset se:
- Asset Final Customer Formula è MTL (inserito altrimenti non funziona)
- Warranty Status checkbox è true
- In Warranty è vuoto
- Expiration Warranty è non vuoto</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
