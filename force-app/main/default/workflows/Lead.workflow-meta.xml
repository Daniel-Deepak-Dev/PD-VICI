    <rules>
        <fullName>Data Affidato Profilo commerciale</fullName>
        <actions>
            <name>Affidato_a_Profilo_Commerciale</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>PRIORVALUE(OwnerId)=&apos;00520000001nVwV&apos; &amp;&amp;  ISCHANGED(OwnerId)  &amp;&amp; isblank( Affidato_a_Profilo_Commerciale__c )</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
