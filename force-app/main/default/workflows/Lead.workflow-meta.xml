    <rules>
        <fullName>Data stato - contacted %2F to be converted</fullName>
        <actions>
            <name>Data_stato_contacted_to_be_converted</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>ISBLANK( Data_stato_contacted_to_be_converted__c  )&amp;&amp;( ISPICKVAL(Status,&quot;Contattato - da convertire&quot;))</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Data stato - not ready</fullName>
        <actions>
            <name>Data_stato_not_ready</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>AND(ISBLANK( Data_stato_not_ready__c  ), OR( ISPICKVAL(Status,&quot;Non compra adesso - Conosce i ns prodotti&quot;) , ISPICKVAL(Status,&quot;Non compra adesso - Conosce i prodotti ed i vantaggi&quot;)) 
)</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Data stato - out of target</fullName>
        <actions>
            <name>Data_stato_out_of_target</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <formula>AND(ISBLANK( Data_stato_out_of_target__c ), OR( ISPICKVAL(Status,&quot;Fuori target&quot;) , ISPICKVAL(Status,&quot;t - serve campo di misura più grande&quot;) , ISPICKVAL(Status,&quot;Need Z&quot;), ISPICKVAL(Status,&quot;Need inner measurements&quot;), ISPICKVAL(Status,&quot;Out of target - competitor - distributor&quot;)) 
)</formula>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
