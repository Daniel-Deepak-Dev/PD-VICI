                  "unit" : "px",
                  "value" : 20.0
                }
              },
              "rawHtml" : "<h1 style=\"font-size: 28px; color: rgb(0, 147, 58); font-weight: bold; margin: 0px; font-family: Arial, Helvetica, sans-serif; border-top: 1px solid rgb(243, 243, 243); padding-top: 20px; padding-bottom: 20px; text-align: center;\"><br />\n<span style=\"font-size:16px;\">Gentile {!$recipient.FirstName},</span></h1>\n\n<div style=\"text-align: center;\"><span style=\"color:#09933a;\"><span style=\"font-size:12pt\"><span style=\"line-height:115%\"><span style=\"font-family:Aptos,sans-serif\"><b>Scopri il primo servizio accreditato in Italia per la taratura ottica 2D.<br />\n<br />\nMisura. Certifica. Affidati ai migliori.</b></span></span></span></span></div>\n<br />\n "
            },
            "definition" : "lightning/html",
            "id" : "f0f3e109-a9e6-4e46-8377-f0b88bfbe0bb",
            "type" : "block"
          }, {
            "attributes" : {
              "lightning:margin" : {
                "bottom" : {
                  "unit" : "px",
                  "value" : 30.0
                },
                "left" : {
                  "unit" : "px",
                  "value" : 20.0
                },
                "right" : {
                  "unit" : "px",
                  "value" : 20.0
                },
                "top" : {
                  "unit" : "px",
                  "value" : 0.0
                }
              },
              "rawHtml" : "<span style=\"line-height:1.5;\"><span style=\"color:#444444;\"><span style=\"font-size:14px;\"><span style=\"font-family:Arial,Helvetica,sans-serif;\">CALIBRA di VICI&amp;C. è il <b>primo laboratorio in Italia accreditato da ACCREDIA</b> per la taratura di macchine di misura ottica 2D su pezzi a simmetria di rivoluzione.<br />\n<br />\nUn servizio unico, <b>riconosciuto a livello nazionale e internazionale</b>, che ti offre tutta la tranquillità della conformità normativa e della precisione metrologica.</span></span></span></span>"
            },
            "definition" : "lightning/html",
            "id" : "18f8d2a4-9f60-49fc-a77b-1921dfd991d1",
            "type" : "block"
          }, {
            "attributes" : {
